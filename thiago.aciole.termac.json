{
    "id": "thiago.aciole.Termac.Devel",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "termac",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--talk-name=org.freedesktop.Flatpak"
    ],
    "cleanup": [
        "/bin/zig",
        "/lib/zig",
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "zig",
            "buildsystem": "simple",
            "build-commands": [
                "install -d /app/bin /app/lib/zig",
                "cp -a zig-x86_64-linux-0.16.0/. /app/lib/zig/",
                "ln -s ../lib/zig/zig /app/bin/zig"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://ziglang.org/download/0.16.0/zig-x86_64-linux-0.16.0.tar.xz",
                    "sha256": "70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00",
                    "strip-components": 0
                }
            ]
        },
        {
            "name": "termac",
            "buildsystem": "meson",
            "build-options": {
                "build-args": [
                    "--share=network"
                ]
            },
            "sources": [
                {
                    "type": "dir",
                    "path": ".",
                    "skip": [
                        ".git",
                        ".flatpak-builder",
                        ".superpowers",
                        ".agents",
                        ".claude",
                        "build",
                        "build-flatpak",
                        "build-valgrind",
                        "build-default",
                        "build-flatpak-default",
                        "build-ci-development",
                        "build-ci-default"
                    ]
                }
            ],
            "config-opts": [
                "--libdir=lib",
                "-Dprofile=development"
            ]
        }
    ],
    "build-options": {
        "env": {}
    }
}
