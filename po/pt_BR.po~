#: data/thiago.aciole.termac.gschema.xml.in:24
msgid ""
"Number of lines kept above the visible screen in each tab. Applies "
"immediately to open tabs."
msgstr "Número de linhas mantidas acima da tela em cada aba. Vale imediatamente para as abas abertas."

#: data/thiago.aciole.termac.gschema.xml.in:28
msgid "Confirm closing running programs"
msgstr "Confirmar fechamento de programas em execução"

#: data/thiago.aciole.termac.gschema.xml.in:29
msgid ""
"Ask for confirmation before closing a tab or window whose shell is running a "
"program."
msgstr "Pede confirmação antes de fechar uma aba ou janela cujo shell esteja executando um programa."

#: data/thiago.aciole.termac.gschema.xml.in:33 src/termac-application.c:526
msgid "Notify when tasks finish"
msgstr "Notificar ao concluir tarefas"

#: data/thiago.aciole.termac.gschema.xml.in:34
msgid ""
"Send a desktop notification when a command or long task finishes in a tab "
"that is not in focus."
msgstr "Envia uma notificação do sistema quando um comando ou tarefa longa termina em uma aba que não está em foco."

#: data/thiago.aciole.termac.gschema.xml.in:38 src/termac-application.c:531
msgid "Shell integration"
msgstr "Integração com o shell"

#: data/thiago.aciole.termac.gschema.xml.in:39
msgid ""
"Report command exit status to Termac. Currently supported for Bash, in new "
"tabs."
msgstr "Informa ao Termac o código de saída dos comandos. Atualmente suportado para Bash, em novas abas."

#: data/thiago.aciole.termac.gschema.xml.in:43 src/termac-application.c:536
msgid "Restore tabs at startup"
msgstr "Restaurar abas ao iniciar"

#: data/thiago.aciole.termac.gschema.xml.in:44
msgid ""
"Reopen the tabs of the last window, in their folders, when Termac starts. "
"Commands are never run again."
msgstr ""
"Reabre as abas em suas pastas. Os comandos não são executados novamente"

