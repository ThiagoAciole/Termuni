#: data/thiago.aciole.termac.desktop.in:2
#: data/thiago.aciole.termac.metainfo.xml.in:6 src/termac-window.ui:6
msgid "Termac"
msgstr "Termac"

#: data/thiago.aciole.termac.desktop.in:3
msgid "Use the command line in tabs"
msgstr "Use a linha de comando em abas"

#: data/thiago.aciole.termac.desktop.in:9
msgid "shell;prompt;command;terminal;"
msgstr "shell;prompt;comando;terminal;"

#: data/thiago.aciole.termac.gschema.xml.in:6
msgid "Preferred command-line agent"
msgstr "Agente de linha de comando preferido"

#: data/thiago.aciole.termac.gschema.xml.in:7
msgid "The agent used to format attachments and open new agent tabs."
msgstr "O agente usado para formatar anexos e abrir novas abas de agente."

#: data/thiago.aciole.termac.gschema.xml.in:11 src/termac-application.c:1229
msgid "Color scheme"
msgstr "Esquema de cores"

#: data/thiago.aciole.termac.gschema.xml.in:12
msgid "Choose the application color scheme."
msgstr "Escolhe o esquema de cores do aplicativo."

#: data/thiago.aciole.termac.gschema.xml.in:17
msgid "Terminal font size"
msgstr "Tamanho da fonte do terminal"

#: data/thiago.aciole.termac.gschema.xml.in:18
msgid "Font size in points."
msgstr "Tamanho da fonte em pontos."

#: data/thiago.aciole.termac.gschema.xml.in:22
msgid "Terminal palette"
msgstr "Paleta do terminal"

#: data/thiago.aciole.termac.gschema.xml.in:23
msgid "Color palette used by terminal sessions."
msgstr "Paleta de cores usada pelas sessões do terminal."

#: data/thiago.aciole.termac.gschema.xml.in:28 src/termac-application.c:1263
msgid "Scrollback lines"
msgstr "Linhas de histórico"

#: data/thiago.aciole.termac.gschema.xml.in:29
msgid ""
"Number of lines kept above the visible screen in each tab. Applies "
"immediately to open tabs."
msgstr ""
"Número de linhas mantidas acima da tela em cada aba. Vale imediatamente para "
"as abas abertas."

#: data/thiago.aciole.termac.gschema.xml.in:33
msgid "Confirm closing running programs"
msgstr "Confirmar fechamento de programas em execução"

#: data/thiago.aciole.termac.gschema.xml.in:34
msgid ""
"Ask for confirmation before closing a tab or window whose shell is running a "
"program."
msgstr ""
"Pede confirmação antes de fechar uma aba ou janela cujo shell esteja "
"executando um programa."

#: data/thiago.aciole.termac.gschema.xml.in:38 src/termac-application.c:1275
msgid "Notify when tasks finish"
msgstr "Notificar ao concluir tarefas"

#: data/thiago.aciole.termac.gschema.xml.in:39
msgid ""
"Send a desktop notification when a command or long task finishes in a tab "
"that is not in focus."
msgstr ""
"Envia uma notificação do sistema quando um comando ou tarefa longa termina "
"em uma aba que não está em foco."

#: data/thiago.aciole.termac.gschema.xml.in:43 src/termac-application.c:1271
msgid "Shell integration"
msgstr "Integração com o shell"

#: data/thiago.aciole.termac.gschema.xml.in:44
msgid ""
"Report command exit status to Termac. Currently supported for Bash, in new "
"tabs."
msgstr ""
"Informa ao Termac o código de saída dos comandos. Atualmente suportado para "
"Bash, em novas abas."

#: data/thiago.aciole.termac.gschema.xml.in:48
msgid "Custom accelerators for window and application actions"
msgstr "Atalhos personalizados para ações da janela e do aplicativo"

#: data/thiago.aciole.termac.gschema.xml.in:49
msgid ""
"Maps action names such as win.new-tab to accelerators. Actions missing from "
"this dictionary use the built-in shortcut."
msgstr ""
"Associa ações como win.new-tab a atalhos. Ações ausentes usam o atalho "
"padrão."

#: data/thiago.aciole.termac.gschema.xml.in:53 src/termac-application.c:1256
msgid "Restore tabs at startup"
msgstr "Restaurar abas ao iniciar"

#: data/thiago.aciole.termac.gschema.xml.in:54
msgid ""
"Reopen the tabs of the last window, in their folders, when Termac starts. "
"Commands are never run again."
msgstr ""
"Reabre as abas em suas pastas. Os comandos não são executados novamente"

#: data/thiago.aciole.termac.metainfo.xml.in:7
msgid "A terminal for GNOME"
msgstr "Um terminal para o GNOME"

#: data/thiago.aciole.termac.metainfo.xml.in:9
msgid ""
"Run command-line tools in independent tabs, search terminal history, and "
"customize fonts and color palettes in a GNOME interface."
msgstr ""
"Execute ferramentas de linha de comando em abas independentes, busque no "
"histórico do terminal e personalize fontes e paletas de cores em uma "
"interface GNOME."

#: data/thiago.aciole.termac.metainfo.xml.in:10
msgid ""
"Termac supports image attachments for command-line agents and can restore "
"tabs in their saved folders."
msgstr ""
"O Termac oferece anexos de imagem para agentes de linha de comando e pode "
"restaurar abas nas pastas salvas."

#: data/thiago.aciole.termac.metainfo.xml.in:13
msgid "Thiago Aciole"
msgstr "Thiago Aciole"

