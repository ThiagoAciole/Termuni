#: data/thiago.aciole.termac.gschema.xml.in:6 src/termac-application.c:1063
msgid "Color scheme"
msgstr "Esquema de cores"

#: data/thiago.aciole.termac.gschema.xml.in:7
msgid "Choose the application color scheme."
msgstr "Escolhe o esquema de cores do aplicativo."

#: data/thiago.aciole.termac.gschema.xml.in:12
msgid "Terminal font size"
msgstr "Tamanho da fonte do terminal"

#: data/thiago.aciole.termac.gschema.xml.in:13
msgid "Font size in points."
msgstr "Tamanho da fonte em pontos."

#: data/thiago.aciole.termac.gschema.xml.in:17
msgid "Terminal palette"
msgstr "Paleta do terminal"

#: data/thiago.aciole.termac.gschema.xml.in:18
msgid "Color palette used by terminal sessions."
msgstr "Paleta de cores usada pelas sessões do terminal."

#: data/thiago.aciole.termac.gschema.xml.in:23 src/termac-application.c:1097
msgid "Scrollback lines"
msgstr "Linhas de histórico"

#: data/thiago.aciole.termac.gschema.xml.in:24
msgid ""
"Number of lines kept above the visible screen in each tab. Applies "
"immediately to open tabs."
msgstr ""
"Número de linhas mantidas acima da tela em cada aba. Vale imediatamente para "
"as abas abertas."

#: data/thiago.aciole.termac.gschema.xml.in:28
msgid "Confirm closing running programs"
msgstr "Confirmar fechamento de programas em execução"

#: data/thiago.aciole.termac.gschema.xml.in:29
msgid ""
"Ask for confirmation before closing a tab or window whose shell is running a "
"program."
msgstr ""
"Pede confirmação antes de fechar uma aba ou janela cujo shell esteja "
"executando um programa."

#: data/thiago.aciole.termac.gschema.xml.in:33 src/termac-application.c:1109
msgid "Notify when tasks finish"
msgstr "Notificar ao concluir tarefas"

#: data/thiago.aciole.termac.gschema.xml.in:34
msgid ""
"Send a desktop notification when a command or long task finishes in a tab "
"that is not in focus."
msgstr ""
"Envia uma notificação do sistema quando um comando ou tarefa longa termina "
"em uma aba que não está em foco."

#: data/thiago.aciole.termac.gschema.xml.in:38 src/termac-application.c:1105
msgid "Shell integration"
msgstr "Integração com o shell"

#: data/thiago.aciole.termac.gschema.xml.in:39
msgid ""
"Report command exit status to Termac. Currently supported for Bash, in new "
"tabs."
msgstr ""
"Informa ao Termac o código de saída dos comandos. Atualmente suportado para "
"Bash, em novas abas."

#: data/thiago.aciole.termac.gschema.xml.in:43
msgid "Custom accelerators for window and application actions"
msgstr "Atalhos personalizados para ações da janela e do aplicativo"

#: data/thiago.aciole.termac.gschema.xml.in:44
msgid ""
"Maps action names such as win.new-tab to accelerators. Actions missing from "
"this dictionary use the built-in shortcut."
msgstr ""

#: data/thiago.aciole.termac.gschema.xml.in:48 src/termac-application.c:1090
msgid "Restore tabs at startup"
msgstr "Restaurar abas ao iniciar"

#: data/thiago.aciole.termac.gschema.xml.in:49
msgid ""
"Reopen the tabs of the last window, in their folders, when Termac starts. "
"Commands are never run again."
msgstr ""
"Reabre as abas em suas pastas. Os comandos não são executados novamente"

